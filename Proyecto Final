inear Regression Prediction')\n","plt.plot(prediction_df['Date'], prediction_df['SVM Prediction'], label='SVM Prediction')\n","\n","# Format the plot\n","plt.title('Apple Price Predictions starting from December 9, 2024')\n","plt.xlabel('Date')\n","plt.ylabel('Predicted Price')\n","plt.legend()\n","plt.grid(True)\n","plt.xticks(rotation=45)\n","plt.tight_layout()\n","plt.show()\n"],"metadata":{"id":"4pTtw4-Oqh_T"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# prompt: Grafica de intervalo de confianza solamente de la prediccion\n","\n","# Assuming 'lr_prediccion' are your point predictions\n","# We need to calculate the confidence interval for these predictions.\n","# This requires knowing the standard error of the prediction.\n","\n","# Since we don't have the standard error directly from the sklearn LinearRegression model,\n","# we can use statsmodels which provides more statistical details including prediction intervals.\n","\n","# First, let's refit the linear regression model using statsmodels to get the necessary information.\n","\n","# Add a constant to the independent variable for statsmodels\n","X_sm = sm.add_constant(X)\n","\n","# Split the data again for statsmodels model\n","x_train_sm, x_test_sm, y_train_sm, y_test_sm = train_test_split(X_sm, y, test_size=0.2, random_state=42) # Using random_state for reproducibility\n","\n","# Fit the OLS model (Ordinary Least Squares)\n","model = sm.OLS(y_train_sm, x_train_sm).fit()\n","\n","# Get the predictions and confidence intervals for the *test set* first to understand the concept\n","# pred_summary_test = model.get_prediction(x_test_sm).summary_frame(alpha=0.05)\n","\n","# Now, let's get the confidence interval for the actual *predictions* made on x_prediccion\n","# We need to add a constant to x_prediccion as well for statsmodels\n","x_prediccion_sm = sm.add_constant(x_prediccion)\n","\n","# Get the prediction summary for the prediction data\n","pred_summary_pred = model.get_prediction(